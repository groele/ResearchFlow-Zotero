  "browser_specific_settings": {
    "zotero": {
      "id": "researchflow@groele.org",
      "strict_min_version": "6.999",
      "strict_max_version": "15.*",
      "update_url": "https://raw.githubusercontent.com/groele/ResearchFlow-Zotero/main/update.json"
    }
  }
