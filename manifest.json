{
  "manifest_version": 3,
  "name": "ResearchFlow Companion",
  "version": "9.0.0",
  "description": "A focused, local-first companion for manuscript pipelines, journal submissions, peer review, and secure metadata synchronization.",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://api.github.com/*",
    "https://*.manuscriptcentral.com/*",
    "https://*.editorialmanager.com/*",
    "https://*.ejournalpress.com/*",
    "https://publish.acs.org/*",
    "https://submission.wiley.com/*",
    "https://*.nature.com/*",
    "https://*.peerx-press.org/*",
    "https://susy.mdpi.com/*",
    "https://review.frontiersin.org/*",
    "https://authors.aps.org/*",
    "https://submission.science.org/*"
  ],
  "optional_host_permissions": [
    "https://graph.microsoft.com/*",
    "https://www.googleapis.com/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.manuscriptcentral.com/*",
        "https://*.editorialmanager.com/*",
        "https://*.ejournalpress.com/*",
        "https://publish.acs.org/*",
        "https://submission.wiley.com/*",
        "https://*.nature.com/*",
        "https://*.peerx-press.org/*",
        "https://susy.mdpi.com/*",
        "https://review.frontiersin.org/*",
        "https://authors.aps.org/*",
        "https://submission.science.org/*"
      ],
      "js": [
        "scripts/journal-portals.js",
        "scripts/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Open ResearchFlow",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "options_page": "pages/options.html",
  "minimum_chrome_version": "116"
}
