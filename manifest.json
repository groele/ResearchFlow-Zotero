{
  "manifest_version": 2,
  "name": "ResearchFlow - 论文管线与投稿全流程管理",
  "version": "10.0.3",
  "description": "ResearchFlow for Zotero: 专为学术科研、论文写作、期刊投稿与同行评审打造的全流程工作台 (完美支持 Zotero 7+ & Zotero 10)",
  "homepage_url": "https://github.com/groele/ResearchFlow-Zotero",
